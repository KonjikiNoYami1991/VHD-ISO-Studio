<Window x:Class="VhdIsoStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:VhdIsoStudio.Core"
        Title="VHD ISO Studio" Icon="Assets/app.ico"
        Width="1180" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="VHD ISO Studio">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ================================================================ HEADER -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" Padding="20,14">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Image Source="Assets/app.png" Width="40" Height="40" Margin="0,0,14,0"
                 AutomationProperties.Name="Logo" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="VHD ISO Studio" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="{l:Tr Subtitle}" FontSize="12.5" Foreground="#F0FFFFFF"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="AdminBadge" Background="#33FFFFFF" CornerRadius="12" Padding="10,4" Margin="0,0,8,0"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="13" Foreground="White" Margin="0,0,6,0"/>
              <TextBlock x:Name="AdminText" Foreground="White" FontSize="12.5" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnOscdimgStatus" Style="{StaticResource OnHeader}" Margin="0,0,8,0" Tag="&#xE958;"
                  Click="BtnOscdimgStatus_Click" ToolTip="{l:Tr TipOscdimgStatus}">
            <TextBlock x:Name="OscdimgStatusText"/>
          </Button>
          <ComboBox x:Name="CmbLanguage" Width="120" Margin="0,0,8,0" SelectionChanged="CmbLanguage_SelectionChanged"
                    ToolTip="{l:Tr TipLanguage}" AutomationProperties.Name="{l:Tr LblLanguage, Plain=True}">
            <ComboBoxItem Tag="" Content="{l:Tr LangAuto}"/>
            <ComboBoxItem Tag="it" Content="Italiano"/>
            <ComboBoxItem Tag="en" Content="English"/>
          </ComboBox>
          <ComboBox x:Name="CmbTheme" Width="150" Margin="0,0,8,0" SelectionChanged="CmbTheme_SelectionChanged"
                    ToolTip="{l:Tr TipTheme}" AutomationProperties.Name="{l:Tr LblTheme, Plain=True}">
            <ComboBoxItem Tag="System" Content="{l:Tr ThemeSystem}"/>
            <ComboBoxItem Tag="Dark" Content="{l:Tr ThemeDark}"/>
            <ComboBoxItem Tag="Medium" Content="{l:Tr ThemeMedium}"/>
            <ComboBoxItem Tag="Light" Content="{l:Tr ThemeLight}"/>
          </ComboBox>
          <Button x:Name="BtnAbout" Style="{StaticResource OnHeader}" Tag="&#xE946;" Click="BtnAbout_Click"
                  ToolTip="{l:Tr TipAbout}" AutomationProperties.Name="{l:Tr BtnAboutA11y, Plain=True}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================================================================ TABS -->
    <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_SelectionChanged">

      <!-- ============================================== TAB 1: AUTOMATICA -->
      <TabItem x:Name="TabAuto" Header="{l:Tr TabAuto}" Tag="&#xE945;" ToolTip="{l:Tr TipTabAuto}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
          <Grid x:Name="AutoRoot">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <!-- Drop zone -->
              <Border x:Name="DropZone" CornerRadius="16" MinHeight="190"
                      Background="{DynamicResource AccentSoft}" AllowDrop="True" Focusable="True"
                      FocusVisualStyle="{StaticResource FocusRing}"
                      DragEnter="DropZone_DragEnter" DragOver="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                      MouseLeftButtonUp="DropZone_Click" KeyDown="DropZone_KeyDown"
                      AutomationProperties.Name="{l:Tr DropZoneA11y, Plain=True}" AutomationProperties.HelpText="{l:Tr TipDropZone}"
                      ToolTip="{l:Tr TipDropZone}" Cursor="Hand" Margin="0,0,0,14">
               <Grid>
                <Rectangle x:Name="DropBorder" StrokeDashArray="5 3" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                           RadiusX="16" RadiusY="16" IsHitTestVisible="False"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                  <TextBlock x:Name="DropIcon" Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="44"
                             Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                      <ScaleTransform x:Name="DropIconScale" ScaleX="1" ScaleY="1"/>
                    </TextBlock.RenderTransform>
                  </TextBlock>
                  <TextBlock x:Name="AutoVhdTitle" Text="{l:Tr DropTitle}" FontSize="17" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Margin="0,10,0,4" TextAlignment="Center" TextWrapping="Wrap"/>
                  <TextBlock x:Name="AutoVhdSub" Text="{l:Tr DropSubtitle}" Style="{StaticResource Muted}"
                             HorizontalAlignment="Center" TextAlignment="Center"/>
                  <Button x:Name="BtnAutoBrowse" Content="{l:Tr BtnBrowseVhd}" Tag="&#xE8E5;" Margin="0,14,0,0"
                          HorizontalAlignment="Center" Click="BtnAutoBrowse_Click" ToolTip="{l:Tr TipBrowseVhd}"/>
                </StackPanel>
               </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{l:Tr AutoOutputTitle}" Style="{StaticResource H2}"/>

                  <Label x:Name="LblAutoOut" Content="{l:Tr LblOutputFolder}" Target="{Binding ElementName=TxtAutoOut}"/>
                  <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="{l:Tr BtnBrowse}" Tag="&#xE8B7;" Margin="8,0,0,0"
                            Click="BtnAutoOut_Click" ToolTip="{l:Tr TipOutputFolder}"/>
                    <TextBox x:Name="TxtAutoOut" ToolTip="{l:Tr TipOutputFolder}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblAutoOut}"/>
                  </DockPanel>

                  <Label x:Name="LblAutoBase" Content="{l:Tr LblBaseMedia}" Target="{Binding ElementName=TxtAutoBase}"/>
                  <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="{l:Tr BtnFolder}" Tag="&#xE8B7;" Margin="8,0,0,0"
                            Click="BtnAutoBaseFolder_Click" ToolTip="{l:Tr TipBaseMediaFolder}"/>
                    <Button DockPanel.Dock="Right" Content="ISO…" Tag="&#xE8E5;" Margin="8,0,0,0"
                            Click="BtnAutoBaseIso_Click" ToolTip="{l:Tr TipBaseMediaIso}"/>
                    <TextBox x:Name="TxtAutoBase" ToolTip="{l:Tr TipBaseMedia}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblAutoBase}"/>
                  </DockPanel>
                  <TextBlock Text="{l:Tr HintBaseMedia}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,12"/>

                  <WrapPanel>
                    <CheckBox x:Name="ChkAutoHash" Content="{l:Tr ChkHash}" Margin="0,4,24,4" ToolTip="{l:Tr TipHash}"/>
                    <CheckBox x:Name="ChkAutoOpen" Content="{l:Tr ChkOpenFolder}" ToolTip="{l:Tr TipOpenFolder}"/>
                  </WrapPanel>

                  <Button x:Name="BtnAutoStart" Style="{StaticResource Primary}" Content="{l:Tr BtnAutoStart}" Tag="&#xE768;"
                          HorizontalAlignment="Left" Margin="0,16,0,0" Click="BtnAutoStart_Click"
                          ToolTip="{l:Tr TipAutoStart}"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{l:Tr AutoHowTitle}" Style="{StaticResource H2}"/>
                  <TextBlock Text="{l:Tr AutoHow1}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                  <TextBlock Text="{l:Tr AutoHow2}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                  <TextBlock Text="{l:Tr AutoHow3}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                  <TextBlock Text="{l:Tr AutoHow4}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                  <TextBlock Text="{l:Tr AutoHow5}" Style="{StaticResource Muted}"/>
                </StackPanel>
              </Border>

              <Border x:Name="ResultCard" Style="{StaticResource Card}" Visibility="Collapsed"
                      AutomationProperties.LiveSetting="Polite">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock x:Name="ResultIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="20"
                               Foreground="{DynamicResource Ok}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ResultTitle" Style="{StaticResource H2}" Margin="0"/>
                  </StackPanel>
                  <TextBlock x:Name="ResultSummary" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                  <TextBox x:Name="ResultDetails" Style="{StaticResource Mono}" MinHeight="80"
                           AutomationProperties.Name="{l:Tr ResultDetailsA11y, Plain=True}"/>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="BtnResultOpen" Content="{l:Tr BtnOpenFolder}" Tag="&#xE838;" Margin="0,0,8,8"
                            Click="BtnResultOpen_Click"/>
                    <Button x:Name="BtnResultCopy" Content="{l:Tr BtnCopyHash}" Tag="&#xE8C8;" Margin="0,0,8,8"
                            Click="BtnResultCopy_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================== TAB 2: MANUALE -->
      <TabItem x:Name="TabManual" Header="{l:Tr TabManual}" Tag="&#xE90F;" ToolTip="{l:Tr TipTabManual}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
          <StackPanel x:Name="ManualRoot">

            <!-- STEP 1: sorgente -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Border Style="{StaticResource StepBadge}">
                    <TextBlock Text="1" Foreground="{DynamicResource OnAccent}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{l:Tr Step1Title}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel Margin="0,0,0,8">
                  <RadioButton x:Name="RbSrcVhd" GroupName="Src" Content="{l:Tr RbSrcVhd}" IsChecked="True"
                               Checked="SourceMode_Changed" ToolTip="{l:Tr TipSrcVhd}"/>
                  <RadioButton x:Name="RbSrcFolder" GroupName="Src" Content="{l:Tr RbSrcFolder}"
                               Checked="SourceMode_Changed" ToolTip="{l:Tr TipSrcFolder}"/>
                </WrapPanel>

                <StackPanel x:Name="PnlSrcVhd">
                  <Label x:Name="LblVhd" Content="{l:Tr LblVhdFile}" Target="{Binding ElementName=TxtVhd}"/>
                  <DockPanel Margin="0,0,0,8">
                    <Button x:Name="BtnDismount" DockPanel.Dock="Right" Content="{l:Tr BtnDismount}" Tag="&#xE7E8;" Margin="8,0,0,0"
                            Click="BtnDismount_Click" ToolTip="{l:Tr TipDismount}" IsEnabled="False"/>
                    <Button x:Name="BtnMount" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="14,7"
                            Content="{l:Tr BtnMount}" Tag="&#xE71B;" Margin="8,0,0,0"
                            Click="BtnMount_Click" ToolTip="{l:Tr TipMount}"/>
                    <Button DockPanel.Dock="Right" Content="{l:Tr BtnBrowse}" Tag="&#xE8E5;" Margin="8,0,0,0"
                            Click="BtnVhdBrowse_Click" ToolTip="{l:Tr TipBrowseVhd}"/>
                    <TextBox x:Name="TxtVhd" ToolTip="{l:Tr TipVhdFile}" AllowDrop="True"
                             PreviewDragOver="Txt_PreviewDragOver" PreviewDrop="TxtVhd_PreviewDrop"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblVhd}"/>
                  </DockPanel>
                  <WrapPanel Margin="0,0,0,8">
                    <CheckBox x:Name="ChkReadOnly" Content="{l:Tr ChkReadOnly}" IsChecked="True" Margin="0,4,24,4"
                              ToolTip="{l:Tr TipReadOnly}"/>
                    <CheckBox x:Name="ChkAssignLetters" Content="{l:Tr ChkAssignLetters}" IsChecked="True"
                              ToolTip="{l:Tr TipAssignLetters}"/>
                  </WrapPanel>

                  <Label x:Name="LblVolumes" Content="{l:Tr LblVolumes}" Target="{Binding ElementName=LstVolumes}"/>
                  <Grid>
                    <ListView x:Name="LstVolumes" MinHeight="120" MaxHeight="220" SelectionMode="Single"
                              SelectionChanged="LstVolumes_SelectionChanged" ToolTip="{l:Tr TipVolumes}"
                              AutomationProperties.LabeledBy="{Binding ElementName=LblVolumes}">
                      <ListView.View>
                        <GridView>
                          <GridViewColumn Header="{l:Tr ColDrive}" Width="70" DisplayMemberBinding="{Binding DriveLetter}"/>
                          <GridViewColumn Header="{l:Tr ColLabel}" Width="170" DisplayMemberBinding="{Binding Label}"/>
                          <GridViewColumn Header="{l:Tr ColFs}" Width="80" DisplayMemberBinding="{Binding FileSystem}"/>
                          <GridViewColumn Header="{l:Tr ColSize}" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                          <GridViewColumn Header="{l:Tr ColUsed}" Width="100" DisplayMemberBinding="{Binding UsedText}"/>
                          <GridViewColumn Header="{l:Tr ColType}" Width="90" DisplayMemberBinding="{Binding PartitionType}"/>
                          <GridViewColumn Header="{l:Tr ColContent}" Width="190" DisplayMemberBinding="{Binding Kind}"/>
                        </GridView>
                      </ListView.View>
                    </ListView>
                    <TextBlock x:Name="VolumesEmpty" Text="{l:Tr VolumesEmpty}" Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0"
                               IsHitTestVisible="False" TextAlignment="Center"/>
                  </Grid>
                </StackPanel>

                <StackPanel x:Name="PnlSrcFolder" Visibility="Collapsed">
                  <Label x:Name="LblSrcFolder" Content="{l:Tr LblSrcFolder}" Target="{Binding ElementName=TxtSrcFolder}"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Tr BtnBrowse}" Tag="&#xE8B7;" Margin="8,0,0,0"
                            Click="BtnSrcFolder_Click" ToolTip="{l:Tr TipSrcFolder}"/>
                    <TextBox x:Name="TxtSrcFolder" ToolTip="{l:Tr TipSrcFolder}" TextChanged="AnyInput_Changed"
                             AllowDrop="True" PreviewDragOver="Txt_PreviewDragOver" PreviewDrop="TxtFolder_PreviewDrop"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblSrcFolder}"/>
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- STEP 2: cattura -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Border Style="{StaticResource StepBadge}">
                    <TextBlock Text="2" Foreground="{DynamicResource OnAccent}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{l:Tr Step2Title}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel Margin="0,0,0,8">
                  <RadioButton x:Name="RbCapDirect" GroupName="Cap" Content="{l:Tr RbCapDirect}" IsChecked="True"
                               Checked="CaptureMode_Changed" ToolTip="{l:Tr TipCapDirect}"/>
                  <RadioButton x:Name="RbCapCopy" GroupName="Cap" Content="{l:Tr RbCapCopy}"
                               Checked="CaptureMode_Changed" ToolTip="{l:Tr TipCapCopy}"/>
                  <RadioButton x:Name="RbCapDism" GroupName="Cap" Content="{l:Tr RbCapDism}"
                               Checked="CaptureMode_Changed" ToolTip="{l:Tr TipCapDism}"/>
                </WrapPanel>

                <StackPanel x:Name="PnlStaging" Visibility="Collapsed">
                  <Label x:Name="LblStaging" Content="{l:Tr LblStaging}" Target="{Binding ElementName=TxtStaging}"/>
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="{l:Tr BtnBrowse}" Tag="&#xE8B7;" Margin="8,0,0,0"
                            Click="BtnStaging_Click" ToolTip="{l:Tr TipStaging}"/>
                    <TextBox x:Name="TxtStaging" ToolTip="{l:Tr TipStaging}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblStaging}"/>
                  </DockPanel>
                  <CheckBox x:Name="ChkKeepStaging" Content="{l:Tr ChkKeepStaging}" ToolTip="{l:Tr TipKeepStaging}"/>
                </StackPanel>

                <Grid x:Name="PnlDism" Visibility="Collapsed" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <Label x:Name="LblWimName" Content="{l:Tr LblWimName}" Target="{Binding ElementName=TxtWimName}"/>
                    <TextBox x:Name="TxtWimName" Margin="0,0,0,8" ToolTip="{l:Tr TipWimName}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblWimName}"/>
                    <Label x:Name="LblWimDesc" Content="{l:Tr LblWimDesc}" Target="{Binding ElementName=TxtWimDesc}"/>
                    <TextBox x:Name="TxtWimDesc" Margin="0,0,0,8" ToolTip="{l:Tr TipWimDesc}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblWimDesc}"/>
                    <Label x:Name="LblWimCompress" Content="{l:Tr LblWimCompress}" Target="{Binding ElementName=CmbWimCompress}"/>
                    <ComboBox x:Name="CmbWimCompress" SelectedIndex="0" Margin="0,0,0,8" ToolTip="{l:Tr TipWimCompress}"
                              AutomationProperties.LabeledBy="{Binding ElementName=LblWimCompress}">
                      <ComboBoxItem Tag="{x:Static l:WimCompression.Max}" Content="{l:Tr CompressMax}"/>
                      <ComboBoxItem Tag="{x:Static l:WimCompression.Fast}" Content="{l:Tr CompressFast}"/>
                      <ComboBoxItem Tag="{x:Static l:WimCompression.None}" Content="{l:Tr CompressNone}"/>
                    </ComboBox>
                    <Label x:Name="LblWimConfig" Content="{l:Tr LblWimConfig}" Target="{Binding ElementName=TxtWimConfig}"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="…" Margin="8,0,0,0" Click="BtnWimConfig_Click"
                              ToolTip="{l:Tr TipWimConfig}" AutomationProperties.Name="{l:Tr BtnBrowse, Plain=True}"/>
                      <TextBox x:Name="TxtWimConfig" ToolTip="{l:Tr TipWimConfig}"
                               AutomationProperties.LabeledBy="{Binding ElementName=LblWimConfig}"/>
                    </DockPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <CheckBox x:Name="ChkWimIntegrity" Content="/CheckIntegrity" IsChecked="True" ToolTip="{l:Tr TipWimIntegrity}"/>
                    <CheckBox x:Name="ChkWimVerify" Content="/Verify" IsChecked="True" ToolTip="{l:Tr TipWimVerify}"/>
                    <CheckBox x:Name="ChkWimBootable" Content="/Bootable" ToolTip="{l:Tr TipWimBootable}"/>
                    <CheckBox x:Name="ChkWimNoRpFix" Content="/NoRpFix" ToolTip="{l:Tr TipWimNoRpFix}"/>
                    <CheckBox x:Name="ChkWimEa" Content="/EA" ToolTip="{l:Tr TipWimEa}"/>
                    <Separator/>
                    <CheckBox x:Name="ChkInject" Content="{l:Tr ChkInject}" ToolTip="{l:Tr TipInject}"
                              Checked="AnyInput_Changed" Unchecked="AnyInput_Changed"/>
                    <Label x:Name="LblManualBase" Content="{l:Tr LblBaseMedia}" Target="{Binding ElementName=TxtManualBase}" Margin="0,6,0,0"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="{l:Tr BtnFolder}" Margin="8,0,0,0" Click="BtnManualBaseFolder_Click"
                              ToolTip="{l:Tr TipBaseMediaFolder}"/>
                      <Button DockPanel.Dock="Right" Content="ISO…" Margin="8,0,0,0" Click="BtnManualBaseIso_Click"
                              ToolTip="{l:Tr TipBaseMediaIso}"/>
                      <TextBox x:Name="TxtManualBase" ToolTip="{l:Tr TipBaseMedia}"
                               AutomationProperties.LabeledBy="{Binding ElementName=LblManualBase}"/>
                    </DockPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- STEP 3: output -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Border Style="{StaticResource StepBadge}">
                    <TextBlock Text="3" Foreground="{DynamicResource OnAccent}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{l:Tr Step3Title}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>

                <Label x:Name="LblIsoOut" Content="{l:Tr LblIsoFile}" Target="{Binding ElementName=TxtIsoOut}"/>
                <DockPanel Margin="0,0,0,10">
                  <Button DockPanel.Dock="Right" Content="{l:Tr BtnSaveAs}" Tag="&#xE74E;" Margin="8,0,0,0"
                          Click="BtnIsoOut_Click" ToolTip="{l:Tr TipIsoFile}"/>
                  <TextBox x:Name="TxtIsoOut" ToolTip="{l:Tr TipIsoFile}" TextChanged="AnyInput_Changed"
                           AutomationProperties.LabeledBy="{Binding ElementName=LblIsoOut}"/>
                </DockPanel>

                <WrapPanel Margin="0,0,0,10">
                  <CheckBox x:Name="ChkManualHash" Content="{l:Tr ChkHash}" IsChecked="True" Margin="0,4,24,4" ToolTip="{l:Tr TipHash}"/>
                  <CheckBox x:Name="ChkManualOpen" Content="{l:Tr ChkOpenFolder}" IsChecked="True" ToolTip="{l:Tr TipOpenFolder}"/>
                </WrapPanel>

                <Label x:Name="LblPreviewManual" Content="{l:Tr LblPreview}" Target="{Binding ElementName=TxtPreviewManual}"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Tag="&#xE8C8;" Margin="8,0,0,0" VerticalAlignment="Top"
                          Click="BtnCopyCmd_Click" ToolTip="{l:Tr TipCopyCmd}" AutomationProperties.Name="{l:Tr BtnCopyCmd, Plain=True}"/>
                  <TextBox x:Name="TxtPreviewManual" Style="{StaticResource Mono}" MinHeight="60"
                           AutomationProperties.LabeledBy="{Binding ElementName=LblPreviewManual}"/>
                </DockPanel>
                <TextBlock x:Name="ManualValidation" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,8,0,0"
                           AutomationProperties.LiveSetting="Polite"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button x:Name="BtnManualStart" Style="{StaticResource Primary}" Content="{l:Tr BtnManualStart}" Tag="&#xE768;"
                          Click="BtnManualStart_Click" ToolTip="{l:Tr TipManualStart}"/>
                  <Button Content="{l:Tr BtnGoOptions}" Tag="&#xE713;" Margin="10,0,0,0" Click="BtnGoOptions_Click"
                          ToolTip="{l:Tr TipGoOptions}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================== TAB 3: OPZIONI OSCDIMG -->
      <TabItem x:Name="TabOptions" Header="{l:Tr TabOptions}" Tag="&#xE713;" ToolTip="{l:Tr TipTabOptions}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
          <StackPanel>
            <!-- oscdimg.exe -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{l:Tr OscdimgExeTitle}" Style="{StaticResource H2}"/>
                <Label x:Name="LblOscdimgPath" Content="{l:Tr LblOscdimgPath}" Target="{Binding ElementName=TxtOscdimgPath}"/>
                <DockPanel Margin="0,0,0,6">
                  <Button DockPanel.Dock="Right" Content="{l:Tr BtnInstallAdk}" Tag="&#xE896;" Margin="8,0,0,0"
                          Click="BtnInstallAdk_Click" ToolTip="{l:Tr TipInstallAdk}"/>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="14,7" Content="{l:Tr BtnPortableOscdimg}"
                          Tag="&#xE8F1;" Margin="8,0,0,0" Click="BtnPortableOscdimg_Click" ToolTip="{l:Tr TipPortableOscdimg}"/>
                  <Button DockPanel.Dock="Right" Content="{l:Tr BtnDetect}" Tag="&#xE72C;" Margin="8,0,0,0"
                          Click="BtnDetectOscdimg_Click" ToolTip="{l:Tr TipDetect}"/>
                  <Button DockPanel.Dock="Right" Content="…" Margin="8,0,0,0" Click="BtnBrowseOscdimg_Click"
                          ToolTip="{l:Tr TipBrowseOscdimg}" AutomationProperties.Name="{l:Tr BtnBrowse, Plain=True}"/>
                  <TextBox x:Name="TxtOscdimgPath" ToolTip="{l:Tr TipOscdimgPath}"
                           AutomationProperties.LabeledBy="{Binding ElementName=LblOscdimgPath}"/>
                </DockPanel>
                <TextBlock x:Name="OscdimgInfo" Style="{StaticResource Muted}" FontSize="12.5"/>
              </StackPanel>
            </Border>

            <!-- Preset -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{l:Tr PresetTitle}" Style="{StaticResource H2}"/>
                <WrapPanel>
                  <Button Content="{l:Tr PresetBoot}" Tag="&#xE7E8;" Margin="0,0,8,8" Click="PresetBoot_Click" ToolTip="{l:Tr TipPresetBoot}"/>
                  <Button Content="{l:Tr PresetData}" Tag="&#xE8B7;" Margin="0,0,8,8" Click="PresetData_Click" ToolTip="{l:Tr TipPresetData}"/>
                  <Button Content="{l:Tr PresetCompat}" Tag="&#xE774;" Margin="0,0,8,8" Click="PresetCompat_Click" ToolTip="{l:Tr TipPresetCompat}"/>
                  <Button Content="{l:Tr PresetFromVolume}" Tag="&#xE721;" Margin="0,0,8,8" Click="PresetFromVolume_Click" ToolTip="{l:Tr TipPresetFromVolume}"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <StackPanel x:Name="OptionsRoot">
              <!-- File system -->
              <Expander Header="{l:Tr GrpFileSystem}" IsExpanded="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <Label x:Name="LblFs" Content="{l:Tr LblFs}" Target="{Binding ElementName=CmbFs}"/>
                    <ComboBox x:Name="CmbFs" SelectedValuePath="Tag" SelectedValue="{Binding FileSystem}" Margin="0,0,0,8"
                              ToolTip="{l:Tr TipFs}" AutomationProperties.LabeledBy="{Binding ElementName=LblFs}">
                      <ComboBoxItem Tag="{x:Static l:IsoFileSystem.UdfOnly}" Content="{l:Tr FsUdf}"/>
                      <ComboBoxItem Tag="{x:Static l:IsoFileSystem.UdfIso}" Content="{l:Tr FsUdfIso}"/>
                      <ComboBoxItem Tag="{x:Static l:IsoFileSystem.JolietIso}" Content="{l:Tr FsJolietIso}"/>
                      <ComboBoxItem Tag="{x:Static l:IsoFileSystem.JolietOnly}" Content="{l:Tr FsJoliet}"/>
                      <ComboBoxItem Tag="{x:Static l:IsoFileSystem.Iso9660}" Content="{l:Tr FsIso}"/>
                      <ComboBoxItem Tag="{x:Static l:IsoFileSystem.Iso9660Long}" Content="{l:Tr FsIsoLong}"/>
                      <ComboBoxItem Tag="{x:Static l:IsoFileSystem.Iso9660Nt}" Content="{l:Tr FsIsoNt}"/>
                      <ComboBoxItem Tag="{x:Static l:IsoFileSystem.DvdVideo}" Content="{l:Tr FsDvd}"/>
                    </ComboBox>
                    <Label x:Name="LblUdfVer" Content="{l:Tr LblUdfVer}" Target="{Binding ElementName=CmbUdfVer}"/>
                    <ComboBox x:Name="CmbUdfVer" SelectedValuePath="Tag" SelectedValue="{Binding UdfVersion}" Margin="0,0,0,8"
                              ToolTip="{l:Tr TipUdfVer}" AutomationProperties.LabeledBy="{Binding ElementName=LblUdfVer}">
                      <ComboBoxItem Tag="{x:Static l:UdfRevision.Default}" Content="{l:Tr UdfDefault}"/>
                      <ComboBoxItem Tag="{x:Static l:UdfRevision.V102}" Content="1.02  (-udfver102)"/>
                      <ComboBoxItem Tag="{x:Static l:UdfRevision.V150}" Content="1.50  (-udfver150)"/>
                      <ComboBoxItem Tag="{x:Static l:UdfRevision.V200}" Content="2.00  (-udfver200)"/>
                    </ComboBox>
                    <Label x:Name="LblUdfReadme" Content="{l:Tr LblUdfReadme}" Target="{Binding ElementName=TxtUdfReadme}"/>
                    <DockPanel Margin="0,0,0,8">
                      <Button DockPanel.Dock="Right" Content="…" Margin="8,0,0,0" Click="BrowseTextFile_Click"
                              ToolTip="{l:Tr TipUdfReadme}" AutomationProperties.Name="{l:Tr BtnBrowse, Plain=True}" x:Name="BtnUdfReadme"/>
                      <TextBox x:Name="TxtUdfReadme" Text="{Binding UdfReadmeFile, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{l:Tr TipUdfReadme}" AutomationProperties.LabeledBy="{Binding ElementName=LblUdfReadme}"/>
                    </DockPanel>
                    <Label x:Name="LblJolietReadme" Content="{l:Tr LblJolietReadme}" Target="{Binding ElementName=TxtJolietReadme}"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="…" Margin="8,0,0,0" Click="BrowseTextFile_Click" x:Name="BtnJolietReadme"
                              ToolTip="{l:Tr TipJolietReadme}" AutomationProperties.Name="{l:Tr BtnBrowse, Plain=True}"/>
                      <TextBox x:Name="TxtJolietReadme" Text="{Binding JolietReadmeFile, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{l:Tr TipJolietReadme}" AutomationProperties.LabeledBy="{Binding ElementName=LblJolietReadme}"/>
                    </DockPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <CheckBox x:Name="ChkUs" IsChecked="{Binding UdfSparse}" Content="{l:Tr OptUs}" ToolTip="{l:Tr TipUs}"/>
                    <CheckBox x:Name="ChkUe" IsChecked="{Binding UdfEmbedFiles}" Content="{l:Tr OptUe}" ToolTip="{l:Tr TipUe}"/>
                    <CheckBox x:Name="ChkUf" IsChecked="{Binding UdfEmbedFileIds}" Content="{l:Tr OptUf}" ToolTip="{l:Tr TipUf}"/>
                    <CheckBox x:Name="ChkYl" IsChecked="{Binding UdfLongAllocDescriptors}" Content="{l:Tr OptYl}" ToolTip="{l:Tr TipYl}"/>
                    <CheckBox x:Name="ChkD" IsChecked="{Binding IsoLowercase}" Content="{l:Tr OptD}" ToolTip="{l:Tr TipD}"/>
                    <CheckBox x:Name="ChkUt" IsChecked="{Binding DvdTruncateIso}" Content="{l:Tr OptUt}" ToolTip="{l:Tr TipUt}"/>
                  </StackPanel>
                </Grid>
              </Expander>

              <!-- Boot -->
              <Expander Header="{l:Tr GrpBoot}" IsExpanded="True">
                <StackPanel>
                  <Label x:Name="LblBootMode" Content="{l:Tr LblBootMode}" Target="{Binding ElementName=CmbBoot}"/>
                  <ComboBox x:Name="CmbBoot" SelectedValuePath="Tag" SelectedValue="{Binding Boot}" Margin="0,0,0,8"
                            ToolTip="{l:Tr TipBootMode}" AutomationProperties.LabeledBy="{Binding ElementName=LblBootMode}">
                    <ComboBoxItem Tag="{x:Static l:BootMode.None}" Content="{l:Tr BootNone}"/>
                    <ComboBoxItem Tag="{x:Static l:BootMode.BiosAndUefi}" Content="{l:Tr BootBoth}"/>
                    <ComboBoxItem Tag="{x:Static l:BootMode.UefiOnly}" Content="{l:Tr BootUefi}"/>
                    <ComboBoxItem Tag="{x:Static l:BootMode.BiosOnly}" Content="{l:Tr BootBios}"/>
                    <ComboBoxItem Tag="{x:Static l:BootMode.SingleCustom}" Content="{l:Tr BootSingle}"/>
                  </ComboBox>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="16"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <Label x:Name="LblBiosFile" Content="{l:Tr LblBiosFile}" Target="{Binding ElementName=TxtBiosFile}"/>
                      <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="…" Margin="8,0,0,0" Click="BrowseBootFile_Click" x:Name="BtnBiosFile"
                                ToolTip="{l:Tr TipBiosFile}" AutomationProperties.Name="{l:Tr BtnBrowse, Plain=True}"/>
                        <TextBox x:Name="TxtBiosFile" Text="{Binding BiosBootFile, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{l:Tr TipBiosFile}" AutomationProperties.LabeledBy="{Binding ElementName=LblBiosFile}"/>
                      </DockPanel>
                      <Label x:Name="LblPlatform" Content="{l:Tr LblPlatform}" Target="{Binding ElementName=TxtPlatform}"/>
                      <TextBox x:Name="TxtPlatform" Text="{Binding PlatformId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                               ToolTip="{l:Tr TipPlatform}" AutomationProperties.LabeledBy="{Binding ElementName=LblPlatform}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <Label x:Name="LblUefiFile" Content="{l:Tr LblUefiFile}" Target="{Binding ElementName=TxtUefiFile}"/>
                      <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="…" Margin="8,0,0,0" Click="BrowseBootFile_Click" x:Name="BtnUefiFile"
                                ToolTip="{l:Tr TipUefiFile}" AutomationProperties.Name="{l:Tr BtnBrowse, Plain=True}"/>
                        <TextBox x:Name="TxtUefiFile" Text="{Binding UefiBootFile, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{l:Tr TipUefiFile}" AutomationProperties.LabeledBy="{Binding ElementName=LblUefiFile}"/>
                      </DockPanel>
                      <Label x:Name="LblLoadSeg" Content="{l:Tr LblLoadSeg}" Target="{Binding ElementName=TxtLoadSeg}"/>
                      <TextBox x:Name="TxtLoadSeg" Text="{Binding LoadSegment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                               ToolTip="{l:Tr TipLoadSeg}" AutomationProperties.LabeledBy="{Binding ElementName=LblLoadSeg}"/>
                    </StackPanel>
                  </Grid>
                  <WrapPanel>
                    <CheckBox x:Name="ChkE" IsChecked="{Binding BootNoEmulation}" Content="{l:Tr OptE}" ToolTip="{l:Tr TipE}" Margin="0,4,24,4"/>
                    <Button Content="{l:Tr BtnUseAdkBoot}" Tag="&#xE896;" Margin="0,0,8,0" Click="BtnUseAdkBoot_Click" ToolTip="{l:Tr TipUseAdkBoot}"/>
                    <Button Content="{l:Tr BtnNoPrompt}" Tag="&#xE916;" Click="BtnNoPrompt_Click" ToolTip="{l:Tr TipNoPrompt}"/>
                  </WrapPanel>
                </StackPanel>
              </Expander>

              <!-- Ottimizzazione e ordine -->
              <Expander Header="{l:Tr GrpOptimize}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <Label x:Name="LblOptimize" Content="{l:Tr LblOptimize}" Target="{Binding ElementName=CmbOptimize}"/>
                    <ComboBox x:Name="CmbOptimize" SelectedValuePath="Tag" SelectedValue="{Binding Optimize}" Margin="0,0,0,8"
                              ToolTip="{l:Tr TipOptimize}" AutomationProperties.LabeledBy="{Binding ElementName=LblOptimize}">
                      <ComboBoxItem Tag="{x:Static l:OptimizeMode.None}" Content="{l:Tr OptNone}"/>
                      <ComboBoxItem Tag="{x:Static l:OptimizeMode.Md5}" Content="{l:Tr OptMd5}"/>
                      <ComboBoxItem Tag="{x:Static l:OptimizeMode.Binary}" Content="{l:Tr OptBinary}"/>
                    </ComboBox>
                    <CheckBox IsChecked="{Binding IgnoreDiamondTimestamps}" Content="{l:Tr OptOi}" ToolTip="{l:Tr TipOi}"/>
                    <CheckBox IsChecked="{Binding ShowDuplicates}" Content="{l:Tr OptOs}" ToolTip="{l:Tr TipOs}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <CheckBox IsChecked="{Binding I386First}" Content="{l:Tr OptY5}" ToolTip="{l:Tr TipY5}"/>
                    <Label x:Name="LblOrderFile" Content="{l:Tr LblOrderFile}" Target="{Binding ElementName=TxtOrderFile}" Margin="0,8,0,0"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="…" Margin="8,0,0,0" Click="BrowseTextFile_Click" x:Name="BtnOrderFile"
                              ToolTip="{l:Tr TipOrderFile}" AutomationProperties.Name="{l:Tr BtnBrowse, Plain=True}"/>
                      <TextBox x:Name="TxtOrderFile" Text="{Binding OrderFile, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{l:Tr TipOrderFile}" AutomationProperties.LabeledBy="{Binding ElementName=LblOrderFile}"/>
                    </DockPanel>
                  </StackPanel>
                </Grid>
              </Expander>

              <!-- Messaggi -->
              <Expander Header="{l:Tr GrpMessages}">
                <WrapPanel>
                  <StackPanel Margin="0,0,40,0">
                    <CheckBox IsChecked="{Binding WarnNonCompliantNames}" Content="{l:Tr OptW1}" ToolTip="{l:Tr TipW1}"/>
                    <CheckBox IsChecked="{Binding WarnNonDosNames}" Content="{l:Tr OptW2}" ToolTip="{l:Tr TipW2}"/>
                    <CheckBox IsChecked="{Binding WarnZeroLength}" Content="{l:Tr OptW3}" ToolTip="{l:Tr TipW3}"/>
                    <CheckBox IsChecked="{Binding ReportEachFile}" Content="{l:Tr OptW4}" ToolTip="{l:Tr TipW4}"/>
                  </StackPanel>
                  <StackPanel>
                    <CheckBox IsChecked="{Binding SuppressSame64kWarning}" Content="{l:Tr OptYd}" ToolTip="{l:Tr TipYd}"/>
                    <CheckBox IsChecked="{Binding AllocationSummary}" Content="{l:Tr OptA}" ToolTip="{l:Tr TipA}"/>
                  </StackPanel>
                </WrapPanel>
              </Expander>

              <!-- Generali -->
              <Expander Header="{l:Tr GrpGeneral}" IsExpanded="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <Label x:Name="LblLabel" Content="{l:Tr LblLabel}" Target="{Binding ElementName=TxtLabel}"/>
                    <TextBox x:Name="TxtLabel" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Margin="0,0,0,8"
                             ToolTip="{l:Tr TipLabel}" AutomationProperties.LabeledBy="{Binding ElementName=LblLabel}"/>
                    <CheckBox x:Name="ChkTimestamp" IsChecked="{Binding UseTimestamp}" Content="{l:Tr OptT}" ToolTip="{l:Tr TipT}"/>
                    <DockPanel Margin="0,4,0,8">
                      <Button DockPanel.Dock="Right" Content="{l:Tr BtnNow}" Tag="&#xE823;" Margin="8,0,0,0" Click="BtnNow_Click"
                              ToolTip="{l:Tr TipNow}"/>
                      <TextBox x:Name="TxtTimestamp" Text="{Binding Timestamp, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{l:Tr TipTimestamp}" AutomationProperties.Name="{l:Tr OptT, Plain=True}"
                               IsEnabled="{Binding IsChecked, ElementName=ChkTimestamp}"/>
                    </DockPanel>
                    <Label x:Name="LblSizeLimit" Content="{l:Tr LblSizeLimit}" Target="{Binding ElementName=CmbSizeLimit}"/>
                    <ComboBox x:Name="CmbSizeLimit" SelectedValuePath="Tag" SelectedValue="{Binding SizeLimit}" Margin="0,0,0,8"
                              ToolTip="{l:Tr TipSizeLimit}" AutomationProperties.LabeledBy="{Binding ElementName=LblSizeLimit}">
                      <ComboBoxItem Tag="{x:Static l:SizeLimitMode.NoLimit}" Content="{l:Tr SizeNoLimit}"/>
                      <ComboBoxItem Tag="{x:Static l:SizeLimitMode.Default}" Content="{l:Tr SizeDefault}"/>
                      <ComboBoxItem Tag="{x:Static l:SizeLimitMode.MaxSize}" Content="{l:Tr SizeMax}"/>
                    </ComboBox>
                    <Label x:Name="LblMaxSize" Content="{l:Tr LblMaxSize}" Target="{Binding ElementName=TxtMaxSize}"/>
                    <TextBox x:Name="TxtMaxSize" Text="{Binding MaxSizeMb, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l:Tr TipMaxSize}" AutomationProperties.LabeledBy="{Binding ElementName=LblMaxSize}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <CheckBox IsChecked="{Binding Gmt}" Content="{l:Tr OptG}" ToolTip="{l:Tr TipG}"/>
                    <CheckBox IsChecked="{Binding IncludeHidden}" Content="{l:Tr OptH}" ToolTip="{l:Tr TipH}"/>
                    <CheckBox IsChecked="{Binding AnsiNames}" Content="{l:Tr OptC}" ToolTip="{l:Tr TipC}"/>
                    <CheckBox IsChecked="{Binding AlignDirRecords}" Content="{l:Tr OptY6}" ToolTip="{l:Tr TipY6}"/>
                    <CheckBox IsChecked="{Binding WriteSharing}" Content="{l:Tr OptYw}" ToolTip="{l:Tr TipYw}"/>
                    <CheckBox IsChecked="{Binding IgnoreOpenFailures}" Content="{l:Tr OptK}" ToolTip="{l:Tr TipK}"/>
                    <CheckBox IsChecked="{Binding ResolveSymlinks}" Content="{l:Tr OptR}" ToolTip="{l:Tr TipR}"/>
                    <CheckBox IsChecked="{Binding ScanOnly}" Content="{l:Tr OptQ}" ToolTip="{l:Tr TipQ}"/>
                    <Label x:Name="LblExtra" Content="{l:Tr LblExtra}" Target="{Binding ElementName=TxtExtra}" Margin="0,8,0,0"/>
                    <TextBox x:Name="TxtExtra" Text="{Binding ExtraArgs, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"
                             ToolTip="{l:Tr TipExtra}" AutomationProperties.LabeledBy="{Binding ElementName=LblExtra}"/>
                  </StackPanel>
                </Grid>
              </Expander>
            </StackPanel>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Label x:Name="LblPreviewOpts" Content="{l:Tr LblPreview}" Target="{Binding ElementName=TxtPreviewOpts}"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Tag="&#xE8C8;" Margin="8,0,0,0" VerticalAlignment="Top"
                          Click="BtnCopyCmd_Click" ToolTip="{l:Tr TipCopyCmd}" AutomationProperties.Name="{l:Tr BtnCopyCmd, Plain=True}"/>
                  <TextBox x:Name="TxtPreviewOpts" Style="{StaticResource Mono}" MinHeight="60"
                           AutomationProperties.LabeledBy="{Binding ElementName=LblPreviewOpts}"/>
                </DockPanel>
                <TextBlock x:Name="OptsValidation" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,8,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================== TAB 4: REGISTRO -->
      <TabItem x:Name="TabLog" Header="{l:Tr TabLog}" Tag="&#xE9D9;" ToolTip="{l:Tr TipTabLog}">
        <DockPanel Margin="20,16">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="{l:Tr BtnCopyLog}" Tag="&#xE8C8;" Margin="0,0,8,0" Click="BtnCopyLog_Click" ToolTip="{l:Tr TipCopyLog}"/>
            <Button Content="{l:Tr BtnSaveLog}" Tag="&#xE74E;" Margin="0,0,8,0" Click="BtnSaveLog_Click" ToolTip="{l:Tr TipSaveLog}"/>
            <Button Content="{l:Tr BtnOpenLogFolder}" Tag="&#xE838;" Margin="0,0,8,0" Click="BtnOpenLogFolder_Click" ToolTip="{l:Tr TipOpenLogFolder}"/>
            <Button Content="{l:Tr BtnClearLog}" Tag="&#xE74D;" Margin="0,0,8,0" Click="BtnClearLog_Click" ToolTip="{l:Tr TipClearLog}"/>
            <CheckBox x:Name="ChkVerbose" Content="{l:Tr ChkVerbose}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{l:Tr TipVerbose}"/>
          </WrapPanel>
          <TextBox x:Name="TxtLog" Style="{StaticResource Mono}" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   AutomationProperties.Name="{l:Tr TabLog, Plain=True}"/>
        </DockPanel>
      </TabItem>
    </TabControl>

    <!-- ================================================================ STATUS BAR -->
    <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
            Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <DockPanel>
            <TextBlock x:Name="StatusPercent" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="12,0,0,0"
                       AutomationProperties.LiveSetting="Off"/>
            <TextBlock x:Name="StatusEta" DockPanel.Dock="Right" Foreground="{DynamicResource FgMuted}" Margin="12,0,0,0"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="StatusIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14"
                         Foreground="{DynamicResource Ok}" Margin="0,0,8,0"/>
              <TextBlock x:Name="StatusText" Text="{l:Tr StatusReady}" TextTrimming="CharacterEllipsis"
                         AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{l:Tr StatusA11y, Plain=True}"/>
            </StackPanel>
          </DockPanel>
          <ProgressBar x:Name="Progress" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="0"
                       AutomationProperties.Name="{l:Tr ProgressA11y, Plain=True}"/>
          <TextBlock x:Name="StatusDetail" Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
        <Button x:Name="BtnCancel" Grid.Column="1" Content="{l:Tr BtnCancel}" Tag="&#xE711;" Margin="16,0,0,0"
                VerticalAlignment="Center" IsEnabled="False" Click="BtnCancel_Click" ToolTip="{l:Tr TipCancel}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
