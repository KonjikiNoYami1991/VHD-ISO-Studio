<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Palette tema "Light" (contrasti verificati WCAG AA: testo >= 4.5:1, componenti >= 3:1) -->
  <Color x:Key="C.Bg">#FFF3F5FA</Color>
  <Color x:Key="C.Accent">#FF4338CA</Color>
  <SolidColorBrush x:Key="Bg" Color="#FFF3F5FA"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="SurfaceAlt" Color="#FFEEF1F7"/>
  <SolidColorBrush x:Key="Hover" Color="#FFE2E7F1"/>
  <SolidColorBrush x:Key="Line" Color="#FF6B7280"/>
  <SolidColorBrush x:Key="Fg" Color="#FF111827"/>
  <SolidColorBrush x:Key="FgMuted" Color="#FF4B5563"/>
  <SolidColorBrush x:Key="Accent" Color="#FF4338CA"/>
  <SolidColorBrush x:Key="AccentHover" Color="#FF3730A3"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Ok" Color="#FF15803D"/>
  <SolidColorBrush x:Key="Warn" Color="#FF92400E"/>
  <SolidColorBrush x:Key="Err" Color="#FFB91C1C"/>
  <SolidColorBrush x:Key="Focus" Color="#FF1D4ED8"/>
  <SolidColorBrush x:Key="InputBg" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Selection" Color="#FFC7D2FE"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#1A4F46E5"/>
  <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF4F46E5" Offset="0"/>
    <GradientStop Color="#FF0E7490" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
